    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1",
    "@types/cors": "^2.8.17",
